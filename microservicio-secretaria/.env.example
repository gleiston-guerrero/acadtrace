# Servidor
PORT=5176

# Base de datos Supabase (Postgres) — mismo schema que usa sga-principal
DB_HOST=aws-1-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxxx
DB_PASSWORD=change-me
DB_SSL=true

# JWT — misma secret que sga-principal (Spring Boot)
JWT_SECRET=change-me
# Clave AES-256 (32 bytes, base64) para cifrar campos sensibles de estudiantes.
# Generar con: openssl rand -base64 32
AES_SECRET_KEY=change-me

# gRPC cliente hacia sga-principal (catalogo: anos lectivos/grados/paralelos/asignaturas)
GRPC_PRINCIPAL_HOST=localhost
GRPC_PRINCIPAL_PORT=9092
# Debe coincidir con el token que exige InternalAuthInterceptor en sga-principal
GRPC_INTERNAL_TOKEN=change-me

# URL del Spring Boot para login y años lectivos (solo lo usa el frontend en dev)
VITE_API_PRINCIPAL=http://localhost:8080/api

# Institución (encabezados de los PDFs)
INST_NOMBRE=Escuela de Educación Básica Provincias Unidas
INST_CIUDAD=Ecuador

# Opcionales (tienen default razonable si se omiten)
# CORS_ORIGIN=*
# FRONTEND_DIST_PATH=client/dist
