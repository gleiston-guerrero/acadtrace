    {
      "id": 8,
      "title": "4.1 Estado de Líder y Consenso Raft (etcd / Clúster)",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "Sin Líder (Partición)"
                },
                "1": {
                  "color": "green",
                  "text": "Líder Raft Activo"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "etcd_server_has_leader",
          "legendFormat": "Líder etcd Raft"
        }
      ]
    },
