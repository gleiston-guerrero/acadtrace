{
  "consumer": {
    "name": "portal-docente"
  },
  "interactions": [
    {
      "description": "consultar calificaciones de una actividad",
      "pending": false,
      "providerStates": [
        {
          "name": "la actividad 9 tiene una calificación"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/docente/calificaciones/",
        "query": {
          "id_actividad": [
            "9"
          ]
        }
      },
      "response": {
        "body": {
          "content": [
            {
              "id_actividad": 9,
              "id_calificacion": 1,
              "id_matricula": 101,
              "nota": "9.00"
            }
          ],
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$[0].id_actividad": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$[0].id_calificacion": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$[0].id_matricula": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$[0].nota": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^\\d{1,2}\\.\\d{2}$"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application/json"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "microservicio-docente"
  }
}