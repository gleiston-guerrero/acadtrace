[run]
omit =
    */migrations/*
    */grpc_services/*_pb2.py
    */grpc_services/*_pb2_grpc.py
    */grpc_services/server.py
    */grpc_services/fix_imports.py
    */management/commands/*

[report]
fail_under = 70
show_missing = True
skip_covered = True

# Equivalente requerido por herramientas que usan la nomenclatura de
# setup.cfg. Coverage.py lee la seccion [report] de este archivo .coveragerc.
[coverage:report]
fail_under = 70
show_missing = True
skip_covered = True
