# =============================================================================
# AcadTrace - Plantilla Oficial de Variables de Entorno (.env.example)
# Copiar este archivo como .env y definir las credenciales seguras correspondientes.
# =============================================================================

# Modo del Conmutador de Auditoria Criptografica (m0=Baseline, m1=Convencional, m2=HMAC+Lamport, m3=Vectorial)
AUDIT=m2

# Base de Datos PostgreSQL Multi-Esquema
DB_HOST=192.0.2.1
DB_PORT=5433
DB_NAME=sga
DB_USER=postgres
DB_PASSWORD=change-me

# Secretos Criptograficos (JWT y AES-256-GCM)
JWT_SECRET=change-me
AES_SECRET_KEY=change-me

# Puertos y Hosts de Comunicacion Inter-Servicios gRPC
GRPC_PRINCIPAL_HOST=sga-principal
GRPC_PRINCIPAL_PORT=9092
DOCENTE_GRPC_HOST=microservicio-docente
DOCENTE_GRPC_PORT=9091
GRPC_INTERNAL_TOKEN=change-me
SGA_PRINCIPAL_URL=http://sga-principal:8080
FCM_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
SOPORTE_GRPC_PORT=9094
ETCD_ENDPOINTS=http://etcd:2379

# Grafana y Observabilidad
GF_SECURITY_ADMIN_PASSWORD=replace-with-grafana-password
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
POSTGRES_EXPORTER_PORT=9187

# IA Generativa (Google Gemini Flash)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
