# JWT — MISMA secret que sga-principal (login único)
JWT_SECRET=***REMOVED***

# URL del Spring Boot principal (solo lo usa el frontend en dev)
VITE_API_PRINCIPAL=http://localhost:8080/api

# Opcionales (tienen default razonable si se omiten)
# CORS_ORIGIN=*
# FRONTEND_DIST_PATH=dist
