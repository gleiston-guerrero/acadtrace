# Forzar normalizacion de finales de linea LF (Criterio E17 - ISO/IEC 25010)
* text=auto eol=lf
*.csv text eol=lf
*.sql text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.java text eol=lf
*.tex text eol=lf
*.md text eol=lf
*.png binary
*.jpg binary
*.jar binary
# Evidencia de carga: conservar bytes exactos para SHA-256, incluidos CRLF y UTF-16.
microservicio-soporte/resultados_repeticiones/** -text
