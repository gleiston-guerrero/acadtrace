@startuml C4_Nivel1_Contexto
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.12.0/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Diagrama C4 - Nivel 1: Contexto de AcadTrace

Person(docente, "Docente", "Gestiona asistencia, actividades y calificaciones.")
Person(representante, "Representante", "Consulta información académica de sus estudiantes mediante la aplicación móvil.")
Person(secretaria, "Secretaría", "Gestiona matrículas, expedientes, representantes y reportes.")
Person(director, "DIRECTOR", "Consulta y administra información académica y de soporte según su rol.")
Person(soporte, "Soporte técnico", "Atiende incidencias, asigna y escala tickets.")
Person(administrador, "ADMINISTRADOR", "Administra usuarios y la configuración operativa según su rol.")

System(acadtrace, "AcadTrace", "Sistema distribuido para gestión académica, matrícula, seguimiento docente y soporte técnico.")

System_Ext(gemini, "Google Gemini", "Servicio externo invocado por microservicio-ia para generación de contenido asistido.")
System_Ext(smtp, "Servidor SMTP", "Servicio configurable para envío de credenciales por correo.")
System_Ext(grafana_cloud, "Grafana Cloud", "Destino opcional configurado mediante Prometheus remote_write.")
System_Ext(fcm, "Firebase Cloud Messaging (FCM)", "Integración opcional para notificaciones push; FCM_ENABLED es false por defecto.")

Rel(docente, acadtrace, "Gestiona clases, asistencia y calificaciones", "REST / gRPC")
Rel(representante, acadtrace, "Consulta información académica", "Aplicación móvil / REST")
Rel(secretaria, acadtrace, "Gestiona matrículas y expedientes", "REST")
Rel(director, acadtrace, "Consulta y gestiona información autorizada", "REST")
Rel(soporte, acadtrace, "Gestiona tickets", "REST")
Rel(administrador, acadtrace, "Administra usuarios y operación", "REST")

Rel(acadtrace, gemini, "Microservicio-ia solicita generación asistida", "HTTP / JSON")
Rel(acadtrace, smtp, "Envía credenciales", "SMTP")
Rel(acadtrace, grafana_cloud, "Puede enviar métricas", "Prometheus remote_write")
Rel(acadtrace, fcm, "Puede enviar notificaciones push", "FCM; opcional")

@enduml
