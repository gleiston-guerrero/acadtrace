@startuml C4_Nivel2_Contenedores
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.12.0/C4_Container.puml

LAYOUT_WITH_LEGEND()
title Diagrama C4 - Nivel 2: Contenedores de AcadTrace

Person(docente, "Docente", "Usuario docente")
Person(representante, "Representante", "Usuario de la aplicación móvil")
Person(administrativo, "Secretaría / DIRECTOR / ADMINISTRADOR", "Usuarios administrativos")
Person(soporte_usuario, "Soporte técnico", "Usuario de soporte")

System_Boundary(acadtrace, "AcadTrace") {
    Container(app_movil, "Aplicación móvil de representantes", "Android / Kotlin / Jetpack Compose", "Consulta académica móvil con persistencia local Room.")
    Container(web_principal, "Frontend principal", "React / JavaScript (JSX) / Vite", "Interfaz web del núcleo académico.")
    Container(web_docente, "Frontend docente", "React / Vite", "Interfaz web de asistencia y calificaciones.")
    Container(web_secretaria, "Frontend de Secretaría", "React / JavaScript (JSX) / Vite", "Interfaz web de matrículas, expedientes y reportes.")
    Container(web_soporte, "Frontend de Soporte", "React / JavaScript (JSX) / Vite", "Interfaz web de gestión de tickets y reportes de soporte.")
    Container(haproxy, "HAProxy", "HAProxy 2.9 / Docker", "Balancea Principal, Docente, Secretaría e IA; publica métricas en :8404.")

    Container(sga_principal, "sga-principal (2 réplicas)", "Java 21 / Spring Boot", "Núcleo académico, autenticación JWT y gRPC :9092.")
    Container(ms_docente, "microservicio-docente (2 réplicas)", "Python 3.12 / Django REST", "Asistencia, actividades y calificaciones; REST :8000 y gRPC :9091.")
    Container(ms_secretaria, "microservicio-secretaria", "Java 21 / Spring Boot", "Matrículas, representantes, trámites y reportes; REST :5176.")
    Container(ms_soporte, "microservicio-soporte", "Java / Spring Boot", "Tickets, gRPC :9094 y elección de líder con etcd; REST :5178 interno.")
    Container(ms_ia, "microservicio-ia", "Python / FastAPI", "Endpoints de generación asistida mediante Google Gemini; :8084.")

    ContainerDb(postgres, "PostgreSQL compartido", "PostgreSQL / destino DB configurable", "Un destino de base de datos con esquemas lógicos sga_principal, sga_secretaria, sga_docente y sga_soporte.")
    Container(etcd, "etcd0", "etcd v3.5.11", "Instancia declarada para elección de líder en :2379.")
    Container(prometheus, "Prometheus", "Prometheus v2.51.0", "Scraping cada 15 s y remote_write configurable.")
    Container(grafana, "Grafana", "Grafana v10.4.0", "Dashboards sobre Prometheus; publicado en :3001.")
    Container(cadvisor, "cAdvisor", "cAdvisor v0.49.1", "Métricas de contenedores; interno :8080, publicado :8085.")
    Container(postgres_exporter, "postgres-exporter", "postgres-exporter v0.15.0", "Métricas de PostgreSQL; :9187.")
    Container(zipkin, "Zipkin", "OpenZipkin 2.24.3", "Recepción de trazas; :9411.")
    Container(spark, "Spark", "Apache Spark 3.5.1", "Procesamiento configurado en el despliegue; :7077 y :8090.")
}

System_Ext(gemini, "Google Gemini", "API externa usada por microservicio-ia.")

Rel(docente, web_principal, "Usa", "HTTP :5173")
Rel(docente, web_docente, "Usa", "HTTP :3000")
Rel(representante, app_movil, "Usa", "Android")
Rel(administrativo, web_principal, "Usa", "HTTP :5173")
Rel(soporte_usuario, web_principal, "Usa", "HTTP :5173")

Rel(app_movil, haproxy, "Peticiones REST", "HTTP :8080 / :8081")
Rel(web_principal, haproxy, "Peticiones REST", "HTTP :8080 / :8082 / :8084")
Rel(web_docente, haproxy, "Peticiones REST", "HTTP :8081")
Rel(web_secretaria, ms_secretaria, "Consume /api/secretario", "HTTP / JSON")

Rel(web_soporte, ms_soporte, "Consume /api/soporte", "HTTP / JSON")

Rel(haproxy, sga_principal, "Enruta REST", "HTTP :8080")
Rel(haproxy, ms_docente, "Enruta REST", "HTTP :8081")
Rel(haproxy, ms_secretaria, "Enruta REST", "HTTP :8082 -> :5176")
Rel(haproxy, ms_ia, "Enruta IA", "HTTP :8084")
Rel(ms_soporte, sga_principal, "Consulta usuarios y roles", "gRPC :9092")
Rel(sga_principal, ms_docente, "Consulta y notifica operaciones docentes", "gRPC :9091")
Rel(ms_secretaria, sga_principal, "Consulta servicios académicos", "gRPC :9092")
Rel(web_secretaria, ms_ia, "Solicita diagnóstico del estudiante", "HTTP POST / JSON :8084")
Rel(ms_ia, gemini, "Solicita inferencia", "HTTP / JSON")

Rel(sga_principal, postgres, "Persiste", "PostgreSQL :5433 / sga_principal")
Rel(ms_secretaria, postgres, "Persiste", "PostgreSQL :5433 / sga_secretaria")
Rel(ms_docente, postgres, "Persiste", "PostgreSQL :5433 / sga_docente")
Rel(ms_soporte, postgres, "Persiste", "PostgreSQL :5433 / sga_soporte")
Rel(ms_soporte, etcd, "Elección de líder", "HTTP :2379")

Rel(prometheus, sga_principal, "Scrapea", "HTTP :8080/actuator/prometheus")
Rel(prometheus, ms_docente, "Scrapea", "HTTP :8000/metrics")
Rel(prometheus, ms_secretaria, "Scrapea", "HTTP :5176/actuator/prometheus")
Rel(prometheus, ms_soporte, "Scrapea", "HTTP :5178/actuator/prometheus")
Rel(prometheus, haproxy, "Scrapea", "HTTP :8404/metrics")
Rel(prometheus, etcd, "Scrapea", "HTTP :2379/metrics")
Rel(prometheus, cadvisor, "Scrapea", "HTTP :8080")
Rel(prometheus, postgres_exporter, "Scrapea", "HTTP :9187")
Rel(grafana, prometheus, "Consulta métricas", "HTTP :9090")
Rel(ms_soporte, zipkin, "Envía trazas", "HTTP :9411")
Rel(spark, postgres, "Lee datos configurados", "PostgreSQL :5433")

@enduml
