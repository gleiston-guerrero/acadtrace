@startuml C4_Nivel3_Componentes_Soporte
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.12.0/C4_Component.puml

LAYOUT_WITH_LEGEND()
title Diagrama C4 - Nivel 3: Componentes de microservicio-soporte

Container_Boundary(soporte, "microservicio-soporte") {
    Component(ticket_controller, "TicketController", "REST Controller", "Endpoints de tickets protegidos por autenticación y autorización.")
    Component(tecnico_controller, "TecnicoController", "REST Controller", "Consulta técnicos asignables.")
    Component(election_controller, "ElectionController", "REST Controller", "Expone el estado de elección de líder.")
    Component(log_controller, "LogController", "REST Controller", "Consulta los registros operativos disponibles.")

    Component(ticket_service, "TicketService", "Application Service", "Reglas de negocio y orquestación de tickets.")
    Component(tecnico_service, "TecnicoService", "Application Service", "Obtiene y filtra técnicos mediante el cliente gRPC.")
    Component(leader_service, "LeaderElectionService", "Service / jetcd", "Mantiene la elección de líder en etcd.")
    Component(scheduled_tasks, "TicketScheduledTasks", "Scheduled Component", "Cierre automático y recordatorios solo desde la instancia líder.")

    Component(ticket_port, "TicketRepositoryPort", "Domain Port", "Contrato de persistencia de tickets.")
    Component(ticket_repository, "JdbcTicketRepository", "Persistence Adapter", "Implementa el puerto con JdbcTemplate.")
    Component(jdbc_template, "JdbcTemplate", "Spring JDBC", "Acceso a tablas del esquema sga_soporte.")
    Component(named_jdbc, "NamedParameterJdbcTemplate", "Spring JDBC", "Actualización programada de tickets con parámetros nombrados.")
    Component(tecnico_grpc, "TecnicoGrpcClient", "gRPC Client", "Consulta usuarios y roles en sga-principal.")
    Component(incidencia_server, "IncidenciaGrpcServer", "gRPC Server", "Recibe incidencias de otros servicios en :9094.")

    Component(jwt_filter, "JwtAuthFilter", "Spring Security Filter", "Autentica peticiones REST con el JWT compartido.")
    Component(memory_appender, "MemoryLogAppender", "Logging Appender", "Conserva eventos de log para consulta operativa.")
    Component(actuator, "Actuator / Micrometer", "Metrics Endpoint", "Expone /actuator/prometheus.")
}

ContainerDb(postgres, "PostgreSQL compartido", "PostgreSQL", "Esquema sga_soporte: tickets, comentarios e historial.")
Container(etcd, "etcd0", "etcd v3.5.11", "Clave de elección de líder en :2379.")
Container(principal, "sga-principal", "gRPC Server", "Servicio UsuarioService en :9092.")
Container(prometheus, "Prometheus", "Prometheus", "Recolecta métricas.")
Container(zipkin, "Zipkin", "OpenZipkin", "Recibe trazas.")

Rel(jwt_filter, ticket_controller, "Autentica y filtra", "REST")
Rel(jwt_filter, tecnico_controller, "Autentica y filtra", "REST")
Rel(jwt_filter, election_controller, "Autentica y filtra", "REST")
Rel(jwt_filter, log_controller, "Autentica y filtra", "REST")
Rel(ticket_controller, ticket_service, "Invoca")
Rel(tecnico_controller, tecnico_service, "Invoca")
Rel(election_controller, leader_service, "Consulta estado")
Rel(incidencia_server, ticket_service, "Crea ticket por incidencia")
Rel(ticket_service, ticket_port, "Usa el puerto")
Rel(ticket_port, ticket_repository, "Implementado por")
Rel(ticket_repository, jdbc_template, "Ejecuta consultas")
Rel(jdbc_template, postgres, "Consulta", "JDBC :5433")
Rel(tecnico_service, tecnico_grpc, "Obtiene técnicos")
Rel(tecnico_grpc, principal, "Consulta usuarios y roles", "gRPC :9092 + internal_token")
Rel(scheduled_tasks, leader_service, "Verifica liderazgo")
Rel(scheduled_tasks, named_jdbc, "Actualiza tickets")
Rel(named_jdbc, postgres, "Actualiza sga_soporte.tickets", "JDBC :5433")
Rel(leader_service, etcd, "Renueva lease y compite", "etcd :2379")
Rel(prometheus, actuator, "Scrapea", "HTTP :5178/actuator/prometheus")
Rel(soporte, zipkin, "Envía trazas", "HTTP :9411")
Rel(log_controller, memory_appender, "Consulta logs")

@enduml
